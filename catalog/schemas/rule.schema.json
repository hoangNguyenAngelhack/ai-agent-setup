{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-agent-setup:catalog:v1:rule",
  "title": "Rule",
  "description": "A constraint or engineering standard with a load scope. See docs/v2/05 §6.3, §8.",
  "type": "object",
  "allOf": [{ "$ref": "urn:ai-agent-setup:catalog:v1:envelope" }],
  "required": ["body", "scope", "enforcement"],
  "properties": {
    "kind": { "const": "Rule" },
    "id": { "$ref": "urn:ai-agent-setup:catalog:v1:envelope#/$defs/ruleId" },
    "body": { "type": ["string", "null"], "minLength": 1 },
    "scope": {
      "oneOf": [
        { "type": "object", "required": ["always"], "additionalProperties": false, "properties": { "always": { "const": true } } },
        { "type": "object", "required": ["paths"], "additionalProperties": false, "properties": { "paths": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } } } },
        { "type": "object", "required": ["capabilities"], "additionalProperties": false, "properties": { "capabilities": { "type": "array", "minItems": 1, "items": { "$ref": "urn:ai-agent-setup:catalog:v1:envelope#/$defs/entityId" } } } }
      ]
    },
    "enforcement": { "enum": ["advisory", "gate", "policy"] }
  },
  "unevaluatedProperties": false
}
