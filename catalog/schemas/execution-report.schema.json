{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-agent-setup:contracts:v1:execution-report",
  "title": "Execution report across runs",
  "description": "Aggregated view of execution runs, quality gate history and host token usage in one project (V2.2, W2.2-05, W2.2-04). Counts and tokens are measured from local artifacts, and runs whose artifacts cannot be read are listed as UNREADABLE, never counted as success. Tokens count only when a signed usage file proves them; a cost in money is only the host's own figure, labelled estimated.",
  "type": "object",
  "required": ["schemaVersion", "generatedAt", "project", "since", "runs", "gates", "usage"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": "execution-report/v1" },
    "generatedAt": { "$ref": "urn:ai-agent-setup:contracts:v1:gate-record#/$defs/timestamp" },
    "project": {
      "type": "object",
      "required": ["name", "commit", "dirty"],
      "additionalProperties": false,
      "properties": { "name": { "type": "string", "minLength": 1 }, "commit": { "type": ["string", "null"] }, "dirty": { "type": "boolean" } }
    },
    "since": { "oneOf": [{ "$ref": "urn:ai-agent-setup:contracts:v1:gate-record#/$defs/timestamp" }, { "type": "null" }] },
    "runs": {
      "type": "object",
      "required": ["total", "byStatus", "byIntegrity", "items"],
      "additionalProperties": false,
      "properties": {
        "total": { "$ref": "#/$defs/count" },
        "byStatus": { "$ref": "#/$defs/runCounts" },
        "byIntegrity": {
          "type": "object",
          "required": ["VERIFIED", "UNSIGNED", "VIOLATED"],
          "additionalProperties": false,
          "properties": { "VERIFIED": { "$ref": "#/$defs/count" }, "UNSIGNED": { "$ref": "#/$defs/count" }, "VIOLATED": { "$ref": "#/$defs/count" } }
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["runId", "status", "integrity", "steps", "stepsSucceeded", "anomalies", "reason", "deliveries"],
            "additionalProperties": false,
            "properties": {
              "runId": { "type": "string", "pattern": "^run-[0-9TZ]+-[0-9a-f]{6}$" },
              "status": { "enum": ["SUCCEEDED", "OUTCOME_VERIFIED", "FAILED", "CANCELLED", "NOT_VERIFIED", "UNREADABLE"] },
              "integrity": { "enum": ["VERIFIED", "UNSIGNED", "VIOLATED", null] },
              "steps": { "$ref": "#/$defs/count" },
              "stepsSucceeded": { "$ref": "#/$defs/count" },
              "anomalies": { "$ref": "#/$defs/count" },
              "reason": { "type": "string", "minLength": 1 },
              "deliveries": { "type": "array", "items": { "$ref": "#/$defs/delivery" } }
            }
          }
        }
      }
    },
    "gates": {
      "type": "object",
      "required": ["invocations", "items"],
      "additionalProperties": false,
      "properties": {
        "invocations": { "$ref": "#/$defs/count" },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["gate", "total", "PASS", "FAIL", "NOT_VERIFIED", "passRateOfVerified", "last", "durationMs", "mixedResultsOnCommit"],
            "additionalProperties": false,
            "properties": {
              "gate": { "$ref": "urn:ai-agent-setup:catalog:v1:envelope#/$defs/gateId" },
              "total": { "$ref": "#/$defs/count" },
              "PASS": { "$ref": "#/$defs/count" },
              "FAIL": { "$ref": "#/$defs/count" },
              "NOT_VERIFIED": { "$ref": "#/$defs/count" },
              "passRateOfVerified": {
                "description": "PASS / (PASS + FAIL); null when no run of the gate was verified. NOT_VERIFIED runs are never counted as passed.",
                "oneOf": [{ "type": "number", "minimum": 0, "maximum": 1 }, { "type": "null" }]
              },
              "last": {
                "type": "object",
                "required": ["status", "at", "runId"],
                "additionalProperties": false,
                "properties": { "status": { "enum": ["PASS", "FAIL", "NOT_VERIFIED"] }, "at": { "type": "string" }, "runId": { "type": "string" } }
              },
              "durationMs": {
                "description": "Measured durations of verified runs (PASS or FAIL); null when there are none.",
                "oneOf": [
                  { "type": "null" },
                  {
                    "type": "object",
                    "required": ["median", "max"],
                    "additionalProperties": false,
                    "properties": { "median": { "type": "number", "minimum": 0 }, "max": { "type": "number", "minimum": 0 } }
                  }
                ]
              },
              "mixedResultsOnCommit": {
                "description": "Commits on which the gate both passed and failed: flaky, or uncommitted changes between runs (the history cannot tell which).",
                "type": "array",
                "items": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "usage": {
      "type": "object",
      "required": ["hosts"],
      "additionalProperties": false,
      "properties": { "hosts": { "type": "array", "items": { "$ref": "#/$defs/hostUsage" } } }
    }
  },
  "$defs": {
    "count": { "type": "integer", "minimum": 0 },
    "runCounts": {
      "type": "object",
      "required": ["SUCCEEDED", "OUTCOME_VERIFIED", "FAILED", "CANCELLED", "NOT_VERIFIED", "UNREADABLE"],
      "additionalProperties": false,
      "properties": {
        "SUCCEEDED": { "$ref": "#/$defs/count" },
        "OUTCOME_VERIFIED": { "$ref": "#/$defs/count" },
        "FAILED": { "$ref": "#/$defs/count" },
        "CANCELLED": { "$ref": "#/$defs/count" },
        "NOT_VERIFIED": { "$ref": "#/$defs/count" },
        "UNREADABLE": { "$ref": "#/$defs/count" }
      }
    },
    "tokens": { "$ref": "urn:ai-agent-setup:contracts:v1:host-usage#/$defs/tokens" },
    "usageStatus": {
      "description": "MEASURED: signed usage file with records. NOT_STARTED: the host printed nothing in a verified run (counted as zero). NOT_REPORTED: signed, but the stream carried no usage. UNSIGNED: no signature proves the file. NOT_RECORDED: delivered before W2.2-04. INVALID: unreadable or off-contract usage file.",
      "enum": ["MEASURED", "NOT_STARTED", "NOT_REPORTED", "UNSIGNED", "NOT_RECORDED", "INVALID"]
    },
    "usageCounts": {
      "type": "object",
      "required": ["MEASURED", "NOT_STARTED", "NOT_REPORTED", "UNSIGNED", "NOT_RECORDED", "INVALID"],
      "additionalProperties": false,
      "properties": {
        "MEASURED": { "$ref": "#/$defs/count" },
        "NOT_STARTED": { "$ref": "#/$defs/count" },
        "NOT_REPORTED": { "$ref": "#/$defs/count" },
        "UNSIGNED": { "$ref": "#/$defs/count" },
        "NOT_RECORDED": { "$ref": "#/$defs/count" },
        "INVALID": { "$ref": "#/$defs/count" }
      }
    },
    "delivery": {
      "type": "object",
      "required": ["host", "status", "tokens", "costUsd"],
      "additionalProperties": false,
      "properties": {
        "host": { "type": "string", "minLength": 1 },
        "status": { "$ref": "#/$defs/usageStatus" },
        "tokens": { "oneOf": [{ "$ref": "#/$defs/tokens" }, { "type": "null" }] },
        "costUsd": { "oneOf": [{ "type": "number", "minimum": 0 }, { "type": "null" }] }
      }
    },
    "hostUsage": {
      "type": "object",
      "required": ["host", "deliveries", "byStatus", "tokens", "complete", "acceptedOutcomes", "perAcceptedOutcome", "reason", "cost"],
      "additionalProperties": false,
      "properties": {
        "host": { "type": "string", "minLength": 1 },
        "deliveries": { "$ref": "#/$defs/count" },
        "byStatus": { "$ref": "#/$defs/usageCounts" },
        "tokens": { "description": "Sum over MEASURED and NOT_STARTED deliveries only; a lower bound when complete is false.", "$ref": "#/$defs/tokens" },
        "complete": { "type": "boolean" },
        "acceptedOutcomes": { "description": "SUCCEEDED runs with at least one delivery to this host.", "$ref": "#/$defs/count" },
        "perAcceptedOutcome": {
          "description": "Tokens of every delivery to this host, accepted or not, divided by the accepted outcomes; null when incomplete or when there is no accepted outcome.",
          "oneOf": [{ "type": "object", "required": ["input", "output", "cacheRead", "cacheWrite"], "additionalProperties": false, "properties": { "input": { "type": "number", "minimum": 0 }, "output": { "type": "number", "minimum": 0 }, "cacheRead": { "type": "number", "minimum": 0 }, "cacheWrite": { "type": "number", "minimum": 0 } } }, { "type": "null" }]
        },
        "reason": { "type": "string", "minLength": 1 },
        "cost": {
          "oneOf": [
            {
              "type": "object",
              "required": ["usd", "perAcceptedOutcomeUsd", "label", "basis"],
              "additionalProperties": false,
              "properties": {
                "usd": { "type": "number", "minimum": 0 },
                "perAcceptedOutcomeUsd": { "oneOf": [{ "type": "number", "minimum": 0 }, { "type": "null" }] },
                "label": { "const": "estimated" },
                "basis": { "type": "string", "minLength": 1 }
              }
            },
            { "type": "null" }
          ]
        }
      },
      "allOf": [{ "if": { "properties": { "complete": { "const": false } } }, "then": { "properties": { "perAcceptedOutcome": { "type": "null" }, "cost": { "type": "null" } } } }]
    }
  }
}
