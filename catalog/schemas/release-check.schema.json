{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-agent-setup:contracts:v1:release-check",
  "title": "Release check report",
  "description": "Release readiness (V2.2, W2.2-08): automated gates measured as PASS, FAIL or NOT_VERIFIED, and the sign-off list read from docs/v2/13-release-checklist.md. READY only when every gate passed and every sign-off is ticked.",
  "type": "object",
  "required": ["schemaVersion", "generatedAt", "package", "project", "gates", "signOff", "status", "blockers"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": "release-check/v1" },
    "generatedAt": { "$ref": "urn:ai-agent-setup:contracts:v1:gate-record#/$defs/timestamp" },
    "package": {
      "type": "object",
      "required": ["name", "version"],
      "additionalProperties": false,
      "properties": { "name": { "type": "string", "minLength": 1 }, "version": { "type": "string", "minLength": 1 } }
    },
    "project": {
      "type": "object",
      "required": ["commit", "dirty"],
      "additionalProperties": false,
      "properties": { "commit": { "type": ["string", "null"] }, "dirty": { "type": "boolean" } }
    },
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "status", "evidence"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z-]*$" },
          "title": { "type": "string", "minLength": 1 },
          "status": { "enum": ["PASS", "FAIL", "NOT_VERIFIED"] },
          "evidence": { "type": "string", "minLength": 1 }
        }
      }
    },
    "signOff": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "item", "owner", "done"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^S[0-9]+$" },
          "item": { "type": "string", "minLength": 1 },
          "owner": { "type": "string", "minLength": 1 },
          "done": { "type": "boolean" }
        }
      }
    },
    "status": { "enum": ["READY", "NOT_READY"] },
    "blockers": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  },
  "allOf": [{ "if": { "properties": { "status": { "const": "READY" } } }, "then": { "properties": { "blockers": { "type": "array", "maxItems": 0 } } } }]
}
