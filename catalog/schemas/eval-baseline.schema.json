{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-agent-setup:contracts:v1:eval-baseline",
  "title": "Evaluation baseline",
  "description": "Per-case results and metrics of the bundled evaluation sets, committed with the code (V2.2, W2.2-06). Regression detection compares every case check and metric against it; a case whose text or labels changed has a different digest and is not compared.",
  "type": "object",
  "required": ["schemaVersion", "suites"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": "eval-baseline/v1" },
    "suites": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["metrics", "cases"],
        "additionalProperties": false,
        "properties": {
          "metrics": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "required": ["value", "better"],
              "additionalProperties": false,
              "properties": { "value": { "type": "number" }, "better": { "enum": ["higher", "lower"] } }
            }
          },
          "cases": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "required": ["digest", "checks"],
              "additionalProperties": false,
              "properties": {
                "digest": { "type": "string", "pattern": "^[0-9a-f]{16}$" },
                "checks": { "type": "object", "additionalProperties": { "type": "boolean" } }
              }
            }
          }
        }
      }
    }
  }
}
