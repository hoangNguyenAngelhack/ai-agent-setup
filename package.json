{
  "name": "create-ai-agent-setup",
  "version": "1.6.1",
  "description": "Universal AI engineering configuration for Claude Code and Codex: create or set up projects from a versioned catalog with a safety policy and a safe installer",
  "author": "Hoang Nguyen <hoang.nguyen@angelhack.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hoangNguyenAngelhack/ai-agent-setup.git"
  },
  "homepage": "https://github.com/hoangNguyenAngelhack/ai-agent-setup#readme",
  "bugs": {
    "url": "https://github.com/hoangNguyenAngelhack/ai-agent-setup/issues"
  },
  "keywords": [
    "cli",
    "create",
    "generator",
    "scaffold",
    "claude",
    "ai-agent",
    "typescript",
    "express",
    "nestjs",
    "nextjs",
    "react",
    "react-native",
    "expo",
    "prisma",
    "trpc",
    "mobile",
    "boilerplate",
    "codegraph",
    "mcp",
    "codex",
    "agents-md",
    "agent-skills",
    "claude-code"
  ],
  "bin": {
    "create-ai-agent-setup": "bin/cli.js"
  },
  "files": [
    "bin",
    "dist",
    "catalog",
    "templates",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "catalog:validate": "npm run build && node dist/cli/catalog-validate.js",
    "prepublishOnly": "npm run build && npm test",
    "docs:summary": "npm run build && node scripts/update-readme-summary.cjs",
    "eval:routing": "npm run build && node dist/app/routing-eval-run.js",
    "eval:regressions": "npm run build && node dist/app/eval-regression.js",
    "eval:baseline": "npm run build && node dist/app/eval-regression.js --record"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^20.19.43",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "smol-toml": "^1.9.1",
    "yaml": "^2.9.1"
  }
}
