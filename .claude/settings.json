{
  "permissions": {
    "allow": [
      "Bash(git *)",
      "Bash(gh *)",
      "Bash(mkdir *)",
      "Bash(rm *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(touch *)",
      "Bash(chmod *)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(pnpm *)",
      "Bash(yarn *)",
      "Bash(bun *)",
      "Bash(node *)",
      "Bash(tsx *)",
      "Bash(docker *)",
      "Bash(docker-compose *)",
      "Bash(adb *)",
      "Bash(xcrun *)",
      "Bash(xcodebuild *)",
      "Bash(pod *)",
      "Bash(eas *)",
      "Bash(expo *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(lsof *)",
      "Bash(kill *)",
      "Bash(pkill *)",
      "Bash(open *)",
      "Bash(code *)",
      "Bash(pbcopy *)",
      "Bash(pbpaste *)",
      "WebFetch(*)",
      "WebSearch(*)",
      "Edit(*)",
      "Write(*)",
      "mcp__*",
      "Bash(cat ~/.claude/CLAUDE.md 2>/dev/null || echo \"FILE_NOT_EXISTS\")",
      "Read(//Users/hoangnguyen/.claude/**)",
      "Bash(cp /Users/hoangnguyen/Desktop/labs/npm/ai-agent-setup/.claude/rules/honesty.md /Users/hoangnguyen/Desktop/labs/npm/ai-agent-setup/templates/.claude/rules/honesty.md)"
    ],
    "deny": [],
    "additionalDirectories": [
      "/Users/hoangnguyen/Desktop/labs/npm/ai-agent-setup/.claude/rules",
      "/Users/hoangnguyen/.claude"
    ]
  },
  "model": "claude-opus-4-5",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "echo '[PRE] Running: $TOOL_INPUT' >> /tmp/claude-hooks.log"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "if [ $TOOL_EXIT_CODE -ne 0 ]; then echo '[ERROR] Command failed with exit code $TOOL_EXIT_CODE' >> /tmp/claude-hooks.log; fi"
          }
        ]
      }
    ]
  },
  "context_window": 200000,
  "rules_dir": ".claude/rules",
  "commands_dir": ".claude/commands",
  "skills_dir": ".claude/skills",
  "agents_dir": ".claude/agents"
}
