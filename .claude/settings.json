    ],
    "deny": [],
    "additionalDirectories": [
      "/Users/hoangnguyen/Desktop/labs/npm/ai-agent-setup/.claude/rules",
      "/Users/hoangnguyen/.claude",
      "/Users/hoangnguyen/Desktop/labs/npm/ai-agent-setup/.claude/hooks",
      "/Users/hoangnguyen/Desktop/labs/npm/ai-agent-setup/.claude",
      "/Users/hoangnguyen/Desktop/labs/npm/ai-agent-setup/.claude/agents",
      "/Users/hoangnguyen/Desktop/labs/npm/ai-agent-setup/.claude/mcp-configs"
    ]
  },
  "model": "claude-opus-4-5",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/PreToolUse/security-scan.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/PreToolUse/lint-check.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/PostToolUse/auto-format.sh"
          },
          {
            "type": "command",
            "command": ".claude/hooks/PostToolUse/typescript-check.sh"
          },
          {
            "type": "command",
            "command": ".claude/hooks/PostToolUse/console-log-warn.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/Lifecycle/session-summary.sh"
          },
          {
            "type": "command",
            "command": ".claude/hooks/Lifecycle/cost-tracker.sh"
          }
        ]
      }
    ]
  },
  "context_window": 200000,
  "rules_dir": ".claude/rules",
  "commands_dir": ".claude/commands",
  "skills_dir": ".claude/skills",
  "agents_dir": ".claude/agents"
}
