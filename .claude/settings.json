      "Bash(mkdir -p .claude/hooks/PreToolUse .claude/hooks/PostToolUse .claude/hooks/Lifecycle)",
      "Bash(mkdir -p .claude/mcp-configs)",
      "Bash(cp -r .claude/hooks templates/.claude/)",
      "Bash(cp -r .claude/mcp-configs templates/.claude/)",
      "Bash(cp .claude/agents/react-build-resolver.md .claude/agents/react-native-resolver.md .claude/agents/node-build-resolver.md .claude/agents/prisma-resolver.md templates/.claude/agents/)",
      "Bash(cp .claude/rules/typescript-patterns.md .claude/rules/python-patterns.md .claude/rules/sql-patterns.md templates/.claude/rules/)",
      "Bash(cp .claude/CLAUDE.md templates/.claude/CLAUDE.md)",
