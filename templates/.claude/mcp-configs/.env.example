# MCP Server Environment Variables
# Copy this file to ~/.claude/.env and fill in your values
# NEVER commit this file with real credentials

# =============================================================================
# HIGH PRIORITY - Most commonly used
# =============================================================================

# GitHub - For enhanced git operations
# Create at: https://github.com/settings/tokens
# Scopes: repo, read:org, read:user
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Supabase - PostgreSQL, auth, storage
# Get from: https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Vercel - Deploy and preview
# Create at: https://vercel.com/account/tokens
VERCEL_API_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# =============================================================================
# MEDIUM PRIORITY - Common for production apps
# =============================================================================

# Sentry - Error tracking
# Get from: https://sentry.io/settings/auth-tokens/
SENTRY_AUTH_TOKEN=sntrys_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
SENTRY_ORG=your-org-slug

# Upstash - Serverless Redis
# Get from: https://console.upstash.com/redis
UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Linear - Issue tracking
# Create at: https://linear.app/settings/api
LINEAR_API_KEY=lin_api_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Cloudflare - Workers, KV, R2
# Create at: https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_API_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLOUDFLARE_ACCOUNT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Railway - App deployment
# Create at: https://railway.app/account/tokens
RAILWAY_API_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# =============================================================================
# LOW PRIORITY - As needed
# =============================================================================

# Stripe - Payments
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Resend - Email
# Create at: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Slack - Team messaging
# Create at: https://api.slack.com/apps
SLACK_BOT_TOKEN=xoxb-xxxxxxxxxxxx-xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxx

# Browserbase - Cloud browsers
# Get from: https://browserbase.com/settings
BROWSERBASE_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxx
BROWSERBASE_PROJECT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Firecrawl - Web scraping
# Get from: https://firecrawl.dev/app/api-keys
FIRECRAWL_API_KEY=fc-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Exa - AI web search
# Get from: https://dashboard.exa.ai/api-keys
EXA_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxx
